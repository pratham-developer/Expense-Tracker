# AWS S3 Configuration
VITE_S3_BUCKET=your-s3-bucket-name
VITE_AWS_REGION=your-aws-region
VITE_S3_ACCESS_KEY=your-aws-access-key
VITE_S3_SECRET_KEY=your-aws-secret-key

# API URLs
VITE_API_URL=your-expenses-api-url
VITE_CHAT_API_URL=your-chat-api-url

# AWS Cognito Configuration
VITE_COGNITO_AUTHORITY=your-cognito-authority-url
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:3000
VITE_COGNITO_RESPONSE_TYPE=code
VITE_COGNITO_SCOPE=phone openid email
VITE_COGNITO_DOMAIN=your-cognito-domain
